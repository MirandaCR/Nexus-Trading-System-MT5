# ─────────────────────────────────────────────────────────────────────────────
# Nexus Trader — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── General ───────────────────────────────────────────────────────────────────
NEXUS_ENV=development                    # development | staging | production
NEXUS_TRADING_MODE=live                  # paper | live
NEXUS_SECRET_KEY=change-me-in-production # internal service signing key
NEXUS_JWT_SECRET=change-me-jwt-secret    # JWT token signing secret
NEXUS_PIN=1234                           # dashboard quick-access PIN
NEXUS_AGGRESSIVE_TRADING=false           # true = less restrictive filters
NEXUS_MIN_VERDICT_CONVICTION=70          # minimum conviction to execute (scalping)
NEXUS_CONFLICT_LOCK_CONVICTION=85        # if both bull/bear >= this, force NO_TRADE
NEXUS_ALLOW_OFF_HOURS=false              # false = no trades outside core sessions
PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# ── Scalping mode ───────────────────────────────────────────────────────────
NEXUS_TRADING_MODE_TYPE=scalping         # scalping | swing
NEXUS_OPERATIONAL_TF=M5                  # M5 for scalping, M15 for swing

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── DuckDB ────────────────────────────────────────────────────────────────────
DUCKDB_PATH=./data/nexus.duckdb

# ── Broker: MetaTrader 5 (PRIMARY DATA SOURCE) ─────────────────────────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

DEFAULT_BROKER=mt5
NEXUS_DEFAULT_BROKER=mt5
STREAM_SYMBOLS=XAUUSD
NEXUS_MT5_ISOLATED=1

# CRITICAL: 0 = real MT5 data only. Set 1 ONLY for offline dev without MT5.
NEXUS_DATA_SYNTHETIC_FALLBACK=0

# Dev-only flags (never enable in production)
NEXUS_ALLOW_SYNTHETIC_METRICS=0
NEXUS_ALLOW_SYNTHETIC_TRAINING=0

MT5_SYMBOL_ALIASES=

# ── Broker: Interactive Brokers ──────────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ── LLM Providers ────────────────────────────────────────────────────────────
NEXUS_CLOUD_PROVIDER=deepseek
DEEPSEEK_API_KEY=

# ── Strategy Research ───────────────────────────────────────────────────────
NEXUS_RESEARCH_INTERVAL_SEC=1800
NEXUS_RESEARCH_BATCH=2
NEXUS_DISABLE_RESEARCH=0
NEXUS_DISABLE_RESEARCH_LLM=0
NEXUS_RESEARCH_SYMBOL=XAUUSD
STRATEGY_MIN_PROFIT_FACTOR=1.4
STRATEGY_MIN_WIN_RATE=0.52
STRATEGY_MIN_SHARPE=0.8
STRATEGY_MAX_DD_PCT=18.0
STRATEGY_MIN_TRADES=30
STRATEGY_MIN_NET_PNL_PCT=5.0

# ── Orchestration ───────────────────────────────────────────────────────────
NEXUS_ML_PRIORITY=0                      # 0 = GenAI agents priority, 1 = ML autonomous
NEXUS_ACTIVE_SIGNAL_TTL=120

# ── ML / Models ───────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_DIR=./models_store

# ── News / Social (optional) ──────────────────────────────────────────────────
NEWSAPI_KEY=
GNEWS_KEY=
